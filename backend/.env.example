# Copy to .env and fill in. Scheduler loads these via `export $(cat .env)`.

# --- Daily alerts: email (optional — omit SMTP_HOST to skip email) ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=you@gmail.com
SMTP_PASSWORD=your-app-password
ALERT_EMAIL=you@gmail.com

# --- Daily alerts: Telegram (optional — omit TELEGRAM_TOKEN to skip) ---
# Get token from @BotFather, chat_id from @userinfobot
TELEGRAM_TOKEN=
TELEGRAM_CHAT_ID=
